# Copy to .env (gitignored). Never commit real values.

# MySQL connection URL (SQLAlchemy + PyMySQL). Forms accepted: mysql://, mysql+pymysql://, mariadb://
#   local docker compose : mysql+pymysql://app:app@localhost:3306/app
#   managed (TiDB Cloud / Aiven / RDS / ...): mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl=true
# `?ssl=true` (or DB_SSL=true) turns on TLS using the certifi CA bundle. Special characters in the password must be
# URL-encoded (@ -> %40, / -> %2F, : -> %3A, # -> %23).
DATABASE_URL=mysql+pymysql://app:app@localhost:3306/app
# DB_SSL=true

# Port for `npm start` / Docker (the host usually injects PORT itself). Dev: API on 8000, `ng serve` on 4200.
# PORT=8000

# Third-party API keys go here (the skill adds the ones you asked for), e.g.
# STRIPE_SECRET_KEY=
